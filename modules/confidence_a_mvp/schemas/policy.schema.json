{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1-draft"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PROVISIONAL",
        "TEAM_CONFIRMED"
      ]
    },
    "blocked_score_cap": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "policy_version",
    "status",
    "blocked_score_cap",
    "description"
  ],
  "additionalProperties": false
}
